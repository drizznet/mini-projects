// Prisma schema — maps TypeScript models ↔ Postgres tables.
// Docs: https://www.prisma.io/docs
//
// Workflow:
//   1. Edit this file
//   2. pnpm db:migrate   (creates SQL migration + applies it)  OR  pnpm db:push (prototype)
//   3. pnpm db:generate  (regenerates @prisma/client — also runs after migrate)
//
// DATABASE_URL comes from .env (brew :5432 or Docker :5433).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommitmentPeriod {
  THREE_D @map("3d")
  ONE_W   @map("1w")
  ONE_M   @map("1m")
}

/// Legacy table retained for migration-history compatibility. It is no longer
/// exposed through the Prisma Client or an HTTP module.
model Todo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([completed])
  @@index([createdAt(sort: Desc)])
  @@map("todos")
  @@ignore
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  passwordHarsh String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile       Profile?
  accounts      Account[]
  commitments   Commitment[]
  categories    Category[]

  @@map("users")
  @@index([email])
  @@index([createdAt(sort: Desc)])
}

model Commitment {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String   @db.Uuid
  categoryId                String?  @db.Uuid
  title                     String
  description               String?
  priority                  String   @default("medium")
  status                    String   @default("ongoing")
  targetHours               Float    @default(0)
  targetDate                String?
  startDate                 String?
  commitmentPeriod          CommitmentPeriod?
  dailyCommitmentMinutes    Int?
  scheduledCheckInEnabled   Boolean  @default(false)
  scheduledCheckInTime      String?
  strictCheckIn             Boolean  @default(false)
  workFocusMode             String   @default("flexible")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, createdAt(sort: Desc)])
  @@map("lockedin_commitments")
}

model Category {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @db.Uuid
  name        String
  description String?
  color       String       @default("chart-1")
  icon        String       @default("circle")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitments Commitment[]

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("lockedin_categories")
}

/// 1:1 with User. Primary key is the user's id — a profile cannot exist without that user.
model Profile {
  userId      String   @id @db.Uuid
  avatarUrl   String?
  displayName String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// OAuth login (Google, GitHub, …). Unique per provider + that provider’s user id.
model Account {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}
