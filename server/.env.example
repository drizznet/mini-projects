PORT=4400
CORS_ORIGIN=http://localhost:4200,http://localhost:4300
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# TRUST_PROXY=true
ADMIN_EMAIL=admin@drizznet.local
ADMIN_PASSWORD=drizznet
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL_SEC=86400
GOOGLE_CLIENT_ID=

# Runtime environment: local, dev/development, or production.
ENVIRONMENT=local

# Local runtime target: Docker Compose exposes Postgres on host port 5433.
DATABASE_URL_LOCAL=postgresql://server:server@localhost:5433/server_dev

# Production runtime target: use the pooled Neon connection here.
DATABASE_URL_NEON=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require

# Direct Neon URL for migrations and other session-dependent operations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# The application selects DATABASE_URL from the environment-specific value.
# Prisma CLI reads DATABASE_URL directly; set it to the target you intend to
# migrate before running Prisma migration commands.
DATABASE_URL=postgresql://server:server@localhost:5433/server_dev
